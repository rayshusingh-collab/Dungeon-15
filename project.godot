config_version=5

[application]

config/name="Dungeon15"
config/description="Seeded top-down 2D dungeon roguelite (mobile-first)."
run/main_scene="res://src/main/main.tscn"
config/features=PackedStringArray("4.7")
config/icon="res://icon.svg"

